# Copie para backend/.env e preencha. O arquivo .env nunca deve ser commitado.
# Supabase > Connect > Direct > Session pooler > JDBC
SPRING_DATASOURCE_URL=jdbc:postgresql://<HOST>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<PROJECT_REF>
SPRING_DATASOURCE_PASSWORD=<SENHA>

# Gere com: openssl rand -base64 48
JWT_SECRET=<CHAVE_BASE64_COM_PELO_MENOS_32_BYTES>
