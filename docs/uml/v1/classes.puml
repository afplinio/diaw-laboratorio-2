@startuml classes
title Diagrama de Classes (v1)
skinparam shadowing false
hide empty members

abstract class Usuario {
  login: String
  senha: String
}
class Cliente {
  rg: String
  cpf: String
  nome: String
  endereco: String
  profissao: String
}
class Rendimento {
  entidadeEmpregadora: String
  valor: BigDecimal
}
abstract class Agente {
  nome: String
  cnpj: String
}
class Empresa
class Banco
class Automovel {
  matricula: String
  ano: int
  marca: String
  modelo: String
  placa: String
}
class PedidoAluguel {
  dataInicio: LocalDate
  dataFim: LocalDate
  status: StatusPedido
  parecer: String
}
enum StatusPedido {
  EM_ANALISE
  APROVADO
  REPROVADO
  CANCELADO
  CONTRATADO
}
class Contrato {
  dataAssinatura: LocalDate
}
class ContratoCredito {
  valor: BigDecimal
  taxaJuros: BigDecimal
  parcelas: int
}

Usuario <|-- Cliente
Usuario <|-- Agente
Agente <|-- Empresa
Agente <|-- Banco
Cliente "1" *-- "0..3" Rendimento
Cliente "1" -- "0..*" PedidoAluguel
PedidoAluguel "0..*" --> "1" Automovel
PedidoAluguel --> StatusPedido
Agente "0..1" -- "0..*" PedidoAluguel : avalia
PedidoAluguel "1" -- "0..1" Contrato
Contrato "1" -- "0..1" ContratoCredito
Banco "1" -- "0..*" ContratoCredito : concede
Automovel "0..*" --> "0..1" Cliente : propriedade
Automovel "0..*" --> "0..1" Agente : propriedade
@enduml
