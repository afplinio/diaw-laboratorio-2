@startuml casos-de-uso
title Diagrama de Casos de Uso (v1)
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Usuário" as Usuario
actor "Cliente" as Cliente
actor "Agente" as Agente
actor "Empresa" as Empresa
actor "Banco" as Banco

Usuario <|-- Cliente
Usuario <|-- Agente
Agente <|-- Empresa
Agente <|-- Banco

rectangle "Sistema de Aluguel de Carros" {
  usecase "Cadastrar-se" as UC1
  usecase "Fazer login" as UC2
  usecase "Introduzir pedido" as UC3
  usecase "Consultar pedido" as UC4
  usecase "Modificar pedido" as UC5
  usecase "Cancelar pedido" as UC6
  usecase "Avaliar pedido" as UC7
  usecase "Executar contrato" as UC8
  usecase "Conceder crédito" as UC9
}

Usuario --> UC1
Usuario --> UC2
Cliente --> UC3
Cliente --> UC4
Cliente --> UC5
Cliente --> UC6
Agente --> UC5
Agente --> UC7
Agente --> UC8
Banco --> UC9
UC8 ..> UC9 : <<extend>>
@enduml
